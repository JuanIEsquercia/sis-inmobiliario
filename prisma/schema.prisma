// Prisma schema — sitio público + sincronización del feed Adinco.
// `Listing` es el caché del feed público: se sobreescribe en cada sync y
// no está pensado para cargar el peso del futuro sistema de gestión
// (contratos, inquilinos, pagos), que vivirá en tablas separadas y podrá
// referenciar un Listing sin acoplarse a su ciclo de vida.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Agency {
  id            Int      @id @default(autoincrement())
  externalId    String   @unique // real_estate_id
  name          String
  logoUrl       String?
  officeAddress String?
  officeZipCode String?
  phones        String[]

  listings  Listing[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Listing {
  id         Int     @id @default(autoincrement())
  externalId String  @unique // <id> del aviso en Adinco
  sourceUrl  String?

  title        String
  contentTitle String?
  description  String? @db.Text

  operationType String // "For Sale" | "For Rent"
  propertyType  String // Casa, Departamento, Campo, Terreno...

  priceAmount     Decimal? @db.Decimal(14, 2)
  priceCurrency   String?
  priceRaw        String? // ej. "Consultar precio"
  pricePerHectare Decimal? @db.Decimal(14, 2)
  expenses        Decimal? @db.Decimal(14, 2)

  address          String?
  addressName      String?
  addressNumber    String?
  addressFloor     String?
  addressApartment String?
  country          String?
  region           String?
  city             String?
  neighborhood     String?
  postcode         String?
  latitude         Decimal? @db.Decimal(11, 8)
  longitude        Decimal? @db.Decimal(11, 8)
  orientation      String?

  floorArea             Decimal? @db.Decimal(10, 2)
  plotArea              Decimal? @db.Decimal(10, 2)
  landArea              Decimal? @db.Decimal(10, 2)
  rooms                 Int?
  bathrooms             Int?
  condition             String?
  year                  Int?
  isNew                 Boolean?
  buildingFloors        Int?
  buildingMainElevators Int?
  buildingType          String?
  buildingCategory      String?
  coveredGarages        Int?
  aptoCredito           Boolean?

  fieldLength      Decimal? @db.Decimal(10, 2)
  fieldWidth       Decimal? @db.Decimal(10, 2)
  accessDetail     String?
  distancePavement Decimal? @db.Decimal(10, 2)
  countryType      String?

  services  String[]
  otherData String[]

  sellerName  String?
  sellerEmail String?

  sourceUpdatedAt DateTime? // <date> del aviso en el feed
  isActive        Boolean   @default(true) // false = desapareció del feed (delisted)
  rawData         Json // <ad> completo tal cual vino, sin perder campos

  agencyId Int?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  images ListingImage[]
  videos ListingVideo[]

  // Fase 2 (backoffice): un Listing puede estar bajo gestión (Unit) y/o
  // haber resuelto pedidos de demanda, sin que Listing dependa de ellos.
  unit           Unit?
  matchedPedidos Pedido[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operationType])
  @@index([propertyType])
  @@index([city])
  // Compuesto en vez de un @@index([isActive]) suelto: el listado
  // público siempre filtra isActive Y ordena por sourceUpdatedAt, así
  // que un solo índice cubre las dos cosas sin duplicar mantenimiento.
  // Sigue sirviendo para consultas que solo filtran por isActive, al
  // ser la primera columna.
  @@index([isActive, sourceUpdatedAt])
}

model ListingImage {
  id         Int     @id @default(autoincrement())
  listingId  Int
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url        String
  isFeatured Boolean @default(false)
  sortOrder  Int     @default(0)

  @@index([listingId])
}

model ListingVideo {
  id        Int     @id @default(autoincrement())
  listingId Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String

  @@index([listingId])
}

// Fila única (id fijo = 1) que guarda el último Last-Modified/ETag HTTP
// visto, para saltear el reprocesamiento del feed si no cambió.
model SyncState {
  id           Int       @id @default(1)
  lastModified String?
  etag         String?
  lastSyncedAt DateTime?
}

// ============================================================
// Backoffice (fase 2): usuarios/roles, pedidos y alquileres.
// Todo lo de acá abajo vive separado del caché del feed público
// de arriba — solo se referencia opcionalmente vía Unit <-> Listing.
// ============================================================

enum StaffRole {
  ADMIN
  AGENTE
}

// Espeja auth.users de Supabase (mismo id). La fila se crea sola por un
// trigger de Postgres (handle_new_user) cuando un admin da de alta el
// login en el dashboard de Supabase.
model Profile {
  id          String    @id @db.Uuid
  email       String    @unique
  username    String    @unique
  firstName   String?
  lastName    String?
  role        StaffRole @default(AGENTE)
  // Claves del catálogo en src/lib/permissions.ts. El rol carga un set
  // por defecto al crear el usuario, pero lo que se chequea en cada
  // accion es esto, no el rol.
  permissions String[]  @default([])
  isActive    Boolean   @default(true)

  // Ficha pública opcional — para la página "Nuestro equipo" del sitio.
  // No se publica sola: solo aparece si showOnPublicSite está en true Y
  // tiene foto cargada (ver getPublicTeam). El teléfono es el de
  // contacto público, no un dato interno.
  phone            String?
  bio              String? @db.Text
  photoUrl         String?
  photoStoragePath String?
  showOnPublicSite Boolean @default(false)

  pedidosCreados      Pedido[]           @relation("PedidoCreadoPor")
  contratosCreados    Contract[]         @relation("ContractCreadoPor")
  contractsAsVendedor Contract[]         @relation("ContractVendedor")
  contractsAsCaptador Contract[]         @relation("ContractCaptador")
  documentosSubidos   ContractDocument[]

  rentalCommissionsAsVendedor RentalCommission[]     @relation("RentalCommissionVendedor")
  rentalCommissionsAsCaptador RentalCommission[]     @relation("RentalCommissionCaptador")
  rentalCommissionsCreadas    RentalCommission[]     @relation("RentalCommissionCreadoPor")
  salesAsVendedor             Sale[]                 @relation("SaleVendedor")
  salesAsCaptador             Sale[]                 @relation("SaleCaptador")
  salesCreadas                Sale[]                 @relation("SaleCreadoPor")
  appraisalsAsVendedor        Appraisal[]            @relation("AppraisalVendedor")
  appraisalsCreadas           Appraisal[]            @relation("AppraisalCreadoPor")
  appraisalReportsSubidos     Appraisal[]            @relation("AppraisalReportUploadedBy")
  commissionSchemesAsFijo     CommissionScheme[]     @relation("CommissionSchemeAgenteFijo")
  commissionSchemesCreadas    CommissionScheme[]     @relation("CommissionSchemeCreadoPor")
  contractGroupsCreadas       ContractGroup[]        @relation("ContractGroupCreadoPor")
  contractGroupMemberships    ProfileContractGroup[]
  agentDebtPaymentsRecibidos  AgentDebtPayment[]     @relation("AgentDebtPaymentAgente")
  agentDebtPaymentsCreados    AgentDebtPayment[]     @relation("AgentDebtPaymentCreadoPor")
  expensesCreadas             Expense[]              @relation("ExpenseCreadoPor")
  partnerLogosCreados         PartnerLogo[]          @relation("PartnerLogoCreadoPor")
  cashMovementsAsVendedor     CashMovement[]         @relation("CashMovementVendedor")
  budgetsCreados              Budget[]               @relation("BudgetCreadoPor")
  budgetConceptsCreados       BudgetConcept[]        @relation("BudgetConceptCreadoPor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PedidoEstado {
  ABIERTO
  EN_BUSQUEDA
  CONSEGUIDO
  DESCARTADO
}

// Tablero de demanda: un cliente pide algo que hoy no está en stock: el
// agente lo carga acá para que cualquiera de la agencia pueda ofrecer un
// match desde su propia red, no solo desde los Listing existentes.
model Pedido {
  id Int @id @default(autoincrement())

  clienteNombre   String
  clienteTelefono String?
  clienteEmail    String?

  operationType String // "Venta" | "Alquiler"
  propertyType  String?
  zona          String?
  precioMin     Decimal? @db.Decimal(14, 2)
  precioMax     Decimal? @db.Decimal(14, 2)
  moneda        String?
  ambientesMin  Int?
  notas         String?  @db.Text

  estado PedidoEstado @default(ABIERTO)

  creadoPorId String  @db.Uuid
  creadoPor   Profile @relation("PedidoCreadoPor", fields: [creadoPorId], references: [id])

  matchedListingId Int?
  matchedListing   Listing? @relation(fields: [matchedListingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
}

// La propiedad real bajo gestión. Puede o no estar publicada (Listing);
// existe independiente de él para no perder historial de contratos si el
// aviso se cae del feed.
model Unit {
  id           Int     @id @default(autoincrement())
  // Código interno de referencia (convención Adinco) — la inmobiliaria
  // referencia todas sus propiedades así, esté o no publicada. Único:
  // es la clave real para buscar/reutilizar una unidad entre contratos.
  propertyCode String  @unique
  address      String
  city         String?
  region       String?
  propertyType String?
  notes        String? @db.Text

  listingId Int?     @unique
  listing   Listing? @relation(fields: [listingId], references: [id])

  contracts  Contract[]
  sales      Sale[]
  appraisals Appraisal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Padrón único de personas (propietarios, inquilinos, garantes). Es
// pura identidad/contacto — a propósito NO guarda nada financiero
// (mora, deuda): eso siempre se calcula desde Contract/Payment,
// filtrado por el rol que cumplió en cada contrato puntual, para que
// una persona no "herede" mora de un rol que no cumplió.
model Client {
  id        Int       @id @default(autoincrement())
  firstName String
  lastName  String
  docId     String?
  birthDate DateTime?
  email     String?
  phone     String?

  contractsAsTenant Contract[]          @relation("ContractTenant")
  contractsAsOwner  Contract[]          @relation("ContractOwner")
  guarantorFor      ContractGuarantor[]
  salesAsSeller     Sale[]              @relation("SaleSeller")
  salesAsBuyer      Sale[]              @relation("SaleBuyer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Respaldo final contra duplicados además del chequeo de
  // resolveClient (que ya bloquea la carga con un DNI repetido) — cubre
  // la carrera de dos altas simultáneas con el mismo DNI. Postgres no
  // choca dos NULL entre sí, así que sigue permitiendo cualquier
  // cantidad de clientes sin DNI cargado todavía.
  @@unique([docId])
  @@index([lastName, firstName])
}

// Uno o más por contrato. A diferencia de Owner/Tenant en la v1
// anterior, un mismo Client puede ser garante de varios contratos a lo
// largo del tiempo — por eso es tabla puente, no una fila propia de
// cada contrato.
model ContractGuarantor {
  id Int @id @default(autoincrement())

  contractId Int
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())

  @@unique([contractId, clientId])
}

// Catálogo de índices de actualización (ICL, CAC, IPC...). El admin
// puede cargar nuevos desde el propio formulario de contrato.
model IndexType {
  id   Int     @id @default(autoincrement())
  code String  @unique
  name String?

  contracts   Contract[]
  indexations Indexation[]

  createdAt DateTime @default(now())
}

// Catálogo de conceptos de liquidación (Alquiler, Expensas, Agua, Luz,
// CSP, Mora...). "Alquiler" es isSystem: siempre existe, no se borra.
model Concept {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isSystem Boolean @default(false)

  contractConcepts ContractConcept[]
  paymentItems     PaymentItem[]

  createdAt DateTime @default(now())
}

// Qué conceptos recurrentes tiene un contrato — sin monto: el monto se
// carga liquidación por liquidación porque varía mes a mes (expensas,
// agua...). "Alquiler" no pasa por acá, es implícito en cada Payment.
model ContractConcept {
  id Int @id @default(autoincrement())

  contractId Int
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  conceptId Int
  concept   Concept @relation(fields: [conceptId], references: [id])

  @@unique([contractId, conceptId])
}

// ANULADO: se cargó mal y nunca debió existir — a diferencia de
// FINALIZADO/RESCINDIDO (el alquiler pasó de verdad), acá se borran las
// liquidaciones que todavía no se habían cobrado/cargado (ver
// anularContrato) porque no representan nada real. Solo se puede anular
// si no movió plata todavía (sin RentalCommission y sin liquidaciones
// Cargadas/Pagadas) — si ya movió plata, corresponde finalizarlo.
// BORRADOR/FIRMADO son exclusivos de una colocación sin administración
// (isAdministered false) — no tiene el ciclo de vida de un alquiler que
// administramos (nunca pasa por ACTIVO), es un hecho puntual: se cargó
// (BORRADOR, todavía editable) y se firmó (FIRMADO, cerrado — ver
// marcarContratoFirmado). ACTIVO/FINALIZADO/RESCINDIDO son exclusivos de
// un contrato administrado. ANULADO aplica a cualquiera de los dos.
enum ContractStatus {
  BORRADOR
  FIRMADO
  ACTIVO
  FINALIZADO
  RESCINDIDO
  ANULADO
}

model Contract {
  id Int @id @default(autoincrement())

  unitId Int
  unit   Unit @relation(fields: [unitId], references: [id])

  // Cartera operativa a la que pertenece — determina quién lo puede ver
  // y gestionar (ver ContractGroup). Null = sin asignar todavía, solo
  // visible para quien tenga administraciones.ver_todos.
  groupId Int?
  group   ContractGroup? @relation(fields: [groupId], references: [id])

  // Nullable a propósito: se puede cargar la colocación ya (fecha, monto,
  // comisión) sin tener todavía el nombre completo del propietario o del
  // inquilino — se completa después desde la ficha del contrato (ver
  // actualizarPartesContrato), mismo criterio que Sale.seller/buyer.
  ownerId Int?
  owner   Client? @relation("ContractOwner", fields: [ownerId], references: [id])

  tenantId Int?
  tenant   Client? @relation("ContractTenant", fields: [tenantId], references: [id])

  // Transferencias — se cargan por contrato (no por cliente): cada
  // contrato puede tener una cuenta de cobro distinta, y el agente que
  // liquida necesita tenerla a mano en ese contrato puntual. Esta es la
  // cuenta del ALQUILER (típicamente la del propietario) — ver más abajo
  // la cuenta aparte para cuando el inquilino transfiere la comisión de
  // administración directo a la inmobiliaria.
  paymentAlias String?
  paymentCBU   String?

  // Día del mes en que vence el alquiler mensual — cada contrato pacta
  // el suyo (5, 8, 10...), independiente del día en que arrancó. Antes
  // de este campo, buildPaymentSchedule usaba el día de `startDate` para
  // todo el cronograma; ahora se carga a mano al alta (con esa opción
  // como fallback si se deja vacío) y se congela en cada Payment.dueDate
  // ya generado, no se recalcula retroactivamente si cambia después.
  paymentDueDay Int

  // El dinero de un alquiler administrado nunca pasa por la inmobiliaria
  // salvo por su comisión — normalmente el inquilino transfiere el neto
  // directo al propietario y, aparte, transfiere el % de comisión a la
  // inmobiliaria (no hay un cobro único que después se reparte). Cuando
  // pasa así, la liquidación necesita mostrarle al inquilino a qué
  // cuenta va cada transferencia — esta es la de la inmobiliaria, no la
  // de arriba (que es la del alquiler/propietario).
  tenantPaysCommission Boolean @default(false)
  commissionAlias      String?
  commissionCBU        String?

  // Renovación = contrato nuevo enlazado al anterior, nunca se estira
  // la fecha de fin de uno existente (ya tiene su propio cronograma de
  // liquidaciones/indexaciones generado).
  renewedFromContractId Int?
  renewedFrom           Contract?  @relation("ContractRenewal", fields: [renewedFromContractId], references: [id])
  renewals              Contract[] @relation("ContractRenewal")

  // Si al vencer y renovarse este contrato se espera cobrar la comisión
  // de renovación — no todas las renovaciones la cobran, es un acuerdo
  // caso a caso. null = todavía no se sabe ("a confirmar"): se puede
  // marcar en cualquier momento, no recién cerca del vencimiento. Solo
  // `true` entra a la proyección financiera (ver getProjection); tanto
  // `false` como null quedan afuera del cálculo.
  renewalCommissionExpected Boolean?

  terminatedAt      DateTime?
  terminationReason String?   @db.Text

  startDate      DateTime
  durationMonths Int
  // Calculada (startDate + durationMonths) al crear/editar el contrato;
  // se guarda igual para poder filtrar/ordenar por ella.
  endDate        DateTime

  rentAmount Decimal        @db.Decimal(14, 2)
  currency   String
  status     ContractStatus @default(ACTIVO)

  // Si es false, este contrato es solo "el alquiler que cerramos" — sin
  // liquidaciones mensuales ni indexación propias (las administra otro,
  // o directamente el propietario). managementFeePercent queda null.
  isAdministered Boolean @default(true)

  // % que se descuenta del alquiler en cada liquidación como comisión
  // de administración inmobiliaria (nunca sobre expensas/agua/etc).
  // Null cuando isAdministered es false.
  managementFeePercent Decimal? @db.Decimal(5, 2)

  indexationFrequencyMonths Int?
  indexTypeId               Int?
  indexType                 IndexType? @relation(fields: [indexTypeId], references: [id])
  lastIndexedAt             DateTime?
  nextIndexationDueAt       DateTime?

  notes String? @db.Text

  createdById String  @db.Uuid
  createdBy   Profile @relation("ContractCreadoPor", fields: [createdById], references: [id])

  // Quién colocó este alquiler, cargado siempre al alta del contrato —
  // independiente de si en ese momento se cobra o no una comisión de
  // colocación. RentalCommission tiene su propio vendedor/captador
  // (precargados desde acá pero editables) porque la comisión puede
  // cargarse después y, en ese caso puntual, con otro agente.
  vendedorAgentId String?  @db.Uuid
  vendedorAgent   Profile? @relation("ContractVendedor", fields: [vendedorAgentId], references: [id])
  captadorAgentId String?  @db.Uuid
  captadorAgent   Profile? @relation("ContractCaptador", fields: [captadorAgentId], references: [id])

  guarantors       ContractGuarantor[]
  concepts         ContractConcept[]
  payments         Payment[]
  indexations      Indexation[]
  documents        ContractDocument[]
  rentalCommission RentalCommission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([unitId])
  @@index([groupId])
}

// Cartera operativa: agrupa contratos de administración para asignarle
// la gestión a una persona específica — por acuerdo comercial/operativo
// con cada propietario (a veces ni siquiera coincide con el agente que
// colocó el alquiler), no por ningún atributo del contrato en sí. Se
// arma después del alta, seleccionando contratos ya existentes (ver
// asignarContratosAGrupo) — no hace falta decidir el grupo al cargar el
// contrato.
model ContractGroup {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String? @db.Text

  contracts Contract[]
  members   ProfileContractGroup[]

  createdById String  @db.Uuid
  createdBy   Profile @relation("ContractGroupCreadoPor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Quién puede ver/gestionar los contratos de cada grupo. Un perfil
// puede estar en más de un grupo (ej. alguien que supervisa dos
// carteras) — alguien con administraciones.ver_todos no necesita estar
// en ninguno, ya ve todo sin pasar por acá.
model ProfileContractGroup {
  id Int @id @default(autoincrement())

  profileId String  @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  groupId Int
  group   ContractGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([profileId, groupId])
}

// Cómo llegó (o llega) la plata — usado tanto para el cobro del
// inquilino (PaymentPartialPayment) como para movimientos de Caja
// (CashMovement).
enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
}

// PENDIENTE: todavía se está armando (montos editables). ENVIADA: los
// montos ya están cargados y se le mandó al inquilino (ver el PDF
// exportable) — se congela (ver guardarLiquidacion) hasta que se reabra
// o se cobre, para que lo que ya se envió no cambie por accidente.
// PARCIAL: recibió uno o más cobros que no llegan al total todavía (ver
// PaymentPartialPayment) — la deuda restante queda registrada. PAGADO:
// el acumulado cobrado llegó al total, ya no se toca.
enum PaymentStatus {
  PENDIENTE
  ENVIADA
  PARCIAL
  PAGADO
  ATRASADO
}

// Un registro por período: es la liquidación mensual. El monto total no
// se guarda acá — se suma a partir de sus PaymentItem, para no tener un
// total que se pueda desincronizar de las líneas reales.
model Payment {
  id Int @id @default(autoincrement())

  contractId Int
  contract   Contract @relation(fields: [contractId], references: [id])

  periodMonth Int
  periodYear  Int
  dueDate     DateTime

  currency   String
  status     PaymentStatus @default(PENDIENTE)
  sentAt     DateTime? // cuándo se marcó ENVIADA
  paidAt     DateTime? // cuándo llegó a PAGADO (el cobro que completó el total)
  // Acumulado realmente cobrado hasta ahora — suma de partialPayments.
  // Se guarda acá además de poder sumarse desde partialPayments para
  // no recalcular en cada lectura de la lista; registrarCobro mantiene
  // los dos sincronizados dentro de la misma transacción.
  paidAmount Decimal?      @db.Decimal(14, 2)
  notes      String?

  // Cuándo (y cómo) la inmobiliaria le entregó al propietario el neto de
  // esta liquidación — evento aparte de que el inquilino haya pagado
  // (`status` PAGADO): si el inquilino transfirió directo al propietario
  // no hace falta reenviarle nada, pero si pagó en efectivo la plata
  // queda en la inmobiliaria hasta que se la entrega. No admite pago
  // parcial: es un solo evento, igual que la confirmación de comisión.
  ownerPaidAt        DateTime?
  ownerPaymentMethod PaymentMethod?

  items           PaymentItem[]
  partialPayments PaymentPartialPayment[]
  cashMovement    CashMovement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, periodYear, periodMonth])
  @@index([status])
}

// Cada cobro registrado contra una liquidación — puede haber varios
// (pagos parciales) hasta llegar al total. La comisión de administración
// (CashMovement) recién se reconoce cuando el acumulado llega al total,
// no por cada parcial — ver registrarCobro. Es historial: no se edita
// ni se borra, solo se acumula.
model PaymentPartialPayment {
  id Int @id @default(autoincrement())

  paymentId Int
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  amount Decimal        @db.Decimal(14, 2)
  paidAt DateTime       @default(now())
  // Cómo pagó el inquilino esta parte — ej. efectivo, o transferencia
  // directa al propietario (en ese caso la inmobiliaria todavía no tiene
  // en mano su comisión, aunque el inquilino ya haya pagado del todo:
  // ver Payment.cashMovement / confirmarCobroComision).
  method PaymentMethod?
  notes  String?

  createdAt DateTime @default(now())

  @@index([paymentId])
}

// Una línea de la liquidación (Alquiler, Expensas, Agua...). El monto
// nace en blanco salvo el de Alquiler — se completa liquidación por
// liquidación porque varía mes a mes.
model PaymentItem {
  id Int @id @default(autoincrement())

  paymentId Int
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  conceptId Int
  concept   Concept @relation(fields: [conceptId], references: [id])

  amount Decimal? @db.Decimal(14, 2)
  notes  String?

  @@index([paymentId])
}

// Historial de actualizaciones de precio del contrato.
model Indexation {
  id Int @id @default(autoincrement())

  contractId Int
  contract   Contract @relation(fields: [contractId], references: [id])

  appliedAt      DateTime @default(now())
  previousAmount Decimal  @db.Decimal(14, 2)
  newAmount      Decimal  @db.Decimal(14, 2)

  indexTypeId Int?
  indexType   IndexType? @relation(fields: [indexTypeId], references: [id])
  notes       String?

  createdAt DateTime @default(now())

  @@index([contractId])
}

enum DocumentType {
  CONTRATO
  DNI_INQUILINO
  DNI_GARANTE
  OTRO
}

// Archivos en Supabase Storage (bucket privado "contract-documents");
// acá solo se guarda la referencia. Se suben después de crear el
// contrato, no forman parte de esa transacción.
model ContractDocument {
  id Int @id @default(autoincrement())

  contractId Int
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  type        DocumentType
  fileName    String
  storagePath String

  uploadedById String  @db.Uuid
  uploadedBy   Profile @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@index([contractId])
}

enum CashMovementSource {
  ADMINISTRACION
  COMISION_ALQUILER
  COMISION_RENOVACION
  VENTA
  TASACION
}

// Caja: flujo único de ingresos. Solo ingresos por ahora (sin egresos,
// sin cuentas). Nunca se crea a mano — cada fuente (liquidación pagada,
// alta de venta/tasación/comisión) genera su propio CashMovement en la
// misma transacción que crea el hecho de origen. `description` se arma
// en el momento de creación para que el listado no tenga que resolver
// 4 joins distintos por fila. La invariante "exactamente un FK de
// fuente seteado según `source`" se agrega a mano en la migración (no
// hay @@check en el schema de este proyecto).
model CashMovement {
  id Int @id @default(autoincrement())

  source      CashMovementSource
  description String
  amount      Decimal            @db.Decimal(14, 2)
  currency    String
  occurredAt  DateTime           @default(now())
  // Cómo llegó la plata a la inmobiliaria — opcional porque no todos los
  // movimientos lo cargan (ej. legado, o fuentes donde todavía no se
  // pidió este dato).
  method      PaymentMethod?

  // Agente vendedor responsable de la operación que generó este ingreso
  // — copiado desde la fuente al crear el movimiento (Sale/RentalCommission
  // directo, Appraisal directo, Payment vía su Contract), para que la
  // ficha de Caja se pueda rastrear por agente en un solo campo sin
  // tener que saber de antemano de qué fuente viene cada fila.
  vendedorAgentId String?  @db.Uuid
  vendedorAgent   Profile? @relation("CashMovementVendedor", fields: [vendedorAgentId], references: [id])

  paymentId Int?     @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])

  rentalCommissionId Int?              @unique
  rentalCommission   RentalCommission? @relation(fields: [rentalCommissionId], references: [id])

  // Legado — ver comentario en Sale.cashMovement. Las ventas nuevas usan
  // commissionInstallmentId en su lugar.
  saleId Int?  @unique
  sale   Sale? @relation(fields: [saleId], references: [id])

  commissionInstallmentId Int?                   @unique
  commissionInstallment   CommissionInstallment? @relation(fields: [commissionInstallmentId], references: [id])

  appraisalId Int?       @unique
  appraisal   Appraisal? @relation(fields: [appraisalId], references: [id])

  createdAt DateTime @default(now())

  @@index([source])
  @@index([occurredAt])
  @@index([vendedorAgentId])
}

// RENOVACION: comisión al renovar un contrato existente — unidad de
// negocio distinta de ALQUILER (colocar un inquilino nuevo), con
// participantes propios. Hoy (2026) no tiene esquema configurado
// todavía y el monto va entero a la inmobiliaria (ver
// RentalCommission.origin y crearRentalCommissionEnTx) — queda listo
// para repartirse apenas se defina cómo.
enum CommissionSchemeType {
  VENTA
  ALQUILER
  RENOVACION
}

// Esquema de reparto de comisión para Ventas/Alquileres, versionado y
// append-only: "editar" el esquema desde el admin siempre inserta una
// fila nueva, nunca actualiza una existente — así una operación ya
// cerrada (que congela su propio reparto en Sale/RentalCommission)
// nunca se ve afectada por un cambio de % posterior. La fila vigente
// para un tipo es la de mayor vigenteDesde.
model CommissionScheme {
  id   Int                  @id @default(autoincrement())
  type CommissionSchemeType

  reservaPercent    Decimal @db.Decimal(5, 2) // % del total → fondo de reserva
  agenteFijoPercent Decimal @db.Decimal(5, 2) // % del total → rol fijo

  // Rol configurable: quién ocupa el "agente fijo" hoy. No es una
  // persona hardcodeada — el admin lo reasigna cargando una versión
  // nueva del esquema.
  agenteFijoId String  @db.Uuid
  agenteFijo   Profile @relation("CommissionSchemeAgenteFijo", fields: [agenteFijoId], references: [id])

  // % del "resto" (total - reserva - agenteFijo), no del total.
  // agencia = resto - vendedor - captador (derivado, no se guarda).
  vendedorPercent Decimal @db.Decimal(5, 2)
  captadorPercent Decimal @db.Decimal(5, 2)

  vigenteDesde DateTime @default(now())

  createdById String   @db.Uuid
  createdBy   Profile  @relation("CommissionSchemeCreadoPor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  sales             Sale[]
  rentalCommissions RentalCommission[]

  @@index([type, vigenteDesde])
}

// Comisión de alquiler: hecho único al colocar un contrato nuevo
// (distinto de la administración recurrente, que ya vive en
// managementFeePercent + Payment). Uno por contrato — 1:1, sin
// pipeline: se carga cuando la comisión ya está devengada.
model RentalCommission {
  id Int @id @default(autoincrement())

  contractId Int      @unique
  contract   Contract @relation(fields: [contractId], references: [id])

  amount   Decimal  @db.Decimal(14, 2)
  currency String
  earnedAt DateTime @default(now())

  // Colocar un inquilino nuevo vs. renovarle el contrato a uno que ya
  // estaba son unidades de negocio distintas para la agencia, con
  // participantes propios — se congela automáticamente según
  // contract.renewedFromContractId al momento del alta (nunca lo elige
  // quien carga la comisión), y determina qué CommissionScheme.type se
  // usa para el reparto (ver crearRentalCommissionEnTx).
  origin CommissionSchemeType @default(ALQUILER)

  // Opcionales: si un rol no se completa, se asume que lo cumplió la
  // propia inmobiliaria — ese % queda en agenciaAmount (ver calcularReparto).
  // No aplican a origin = RENOVACION (esa unidad de negocio todavía no
  // tiene reparto por agente vendedor/captador definido).
  vendedorAgentId String?  @db.Uuid
  vendedorAgent   Profile? @relation("RentalCommissionVendedor", fields: [vendedorAgentId], references: [id])
  captadorAgentId String?  @db.Uuid
  captadorAgent   Profile? @relation("RentalCommissionCaptador", fields: [captadorAgentId], references: [id])

  // Null si todavía no había un esquema configurado (del tipo que
  // corresponda según `origin`) al cargar esta comisión — el monto igual
  // se guarda y se puede repartir más adelante (ver Sale para el mismo
  // criterio).
  commissionSchemeId Int?
  commissionScheme   CommissionScheme? @relation(fields: [commissionSchemeId], references: [id])

  // Reparto congelado al momento del alta — suman `amount` cuando no
  // son null. No se recalculan si el esquema cambia después.
  reservaAmount    Decimal? @db.Decimal(14, 2)
  agenteFijoAmount Decimal? @db.Decimal(14, 2)
  vendedorAmount   Decimal? @db.Decimal(14, 2)
  captadorAmount   Decimal? @db.Decimal(14, 2)
  agenciaAmount    Decimal? @db.Decimal(14, 2)

  notes String? @db.Text

  createdById String  @db.Uuid
  createdBy   Profile @relation("RentalCommissionCreadoPor", fields: [createdById], references: [id])

  cashMovement CashMovement?
  installments CommissionInstallment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Venta: hecho único, sin pipeline (sin reservada/escriturada/etc — se
// carga cuando la operación ya cerró y la comisión ya está devengada).
// Reutiliza Unit para que el historial de una propiedad (contratos +
// ventas + tasaciones) quede bajo el mismo id.
model Sale {
  id Int @id @default(autoincrement())

  unitId Int
  unit   Unit @relation(fields: [unitId], references: [id])

  // Parte compradora/vendedora de la operación — personas, no la
  // inmobiliaria. Nullable por compatibilidad con ventas ya cargadas
  // antes de que existieran estos campos; el alta nueva los exige.
  sellerId Int?
  seller   Client? @relation("SaleSeller", fields: [sellerId], references: [id])
  buyerId  Int?
  buyer    Client? @relation("SaleBuyer", fields: [buyerId], references: [id])

  initialPriceAmount Decimal? @db.Decimal(14, 2) // precio de inicio/publicación
  saleAmount         Decimal? @db.Decimal(14, 2) // precio de cierre, informativo — no impacta la Caja
  commissionAmount   Decimal  @db.Decimal(14, 2) // lo efectivamente acordado — ver installments para lo cobrado
  currency           String
  closedAt           DateTime @default(now())

  // Opcionales: si un rol no se completa, se asume que lo cumplió la
  // propia inmobiliaria — ese % queda en agenciaAmount (ver calcularReparto).
  // Son los agentes de la inmobiliaria (staff) — no confundir con
  // seller/buyer arriba, que son las partes de la operación.
  vendedorAgentId String?  @db.Uuid
  vendedorAgent   Profile? @relation("SaleVendedor", fields: [vendedorAgentId], references: [id])
  captadorAgentId String?  @db.Uuid
  captadorAgent   Profile? @relation("SaleCaptador", fields: [captadorAgentId], references: [id])

  // Null si todavía no había un esquema de Venta configurado al cargar
  // esta venta — el monto igual se guarda y se puede repartir más
  // adelante.
  commissionSchemeId Int?
  commissionScheme   CommissionScheme? @relation(fields: [commissionSchemeId], references: [id])

  // Reparto congelado al momento del alta sobre el total de
  // `commissionAmount` — suman `commissionAmount` cuando no son null. No
  // se recalculan si el esquema cambia después, y tampoco si la cobranza
  // se demora: es lo que le corresponde a cada uno del acuerdo ya
  // cerrado, independiente de cuándo se termine de cobrar (ver
  // installments). Sirve de base para liquidar a cada agente su parte.
  reservaAmount    Decimal? @db.Decimal(14, 2)
  agenteFijoAmount Decimal? @db.Decimal(14, 2)
  vendedorAmount   Decimal? @db.Decimal(14, 2)
  captadorAmount   Decimal? @db.Decimal(14, 2)
  agenciaAmount    Decimal? @db.Decimal(14, 2)

  notes String? @db.Text

  createdById String  @db.Uuid
  createdBy   Profile @relation("SaleCreadoPor", fields: [createdById], references: [id])

  // Legado: ventas cargadas antes de que existiera installments tienen
  // acá su único movimiento de caja. Las nuevas ventas siempre cobran a
  // través de installments, aunque sea una sola cuota "de contado".
  cashMovement CashMovement?
  installments CommissionInstallment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
}

enum InstallmentStatus {
  PENDIENTE
  PAGADA
}

// Una sola tabla de cuotas para toda comisión que se cobre en partes,
// sin importar la unidad de negocio (Venta o Alquiler) — mismo esquema
// de registro para las dos, para que se aprenda una sola vez y se pueda
// rastrear cualquier cobro pendiente desde el mismo lugar. El total de
// la operación (Sale.commissionAmount / RentalCommission.amount) SIEMPRE
// se carga aparte, una sola vez — estas filas son un cronograma de cobro
// de ESE total ya fijo, nunca la fuente de ese total (la suma de las
// cuotas tiene que coincidir con el total, se valida al cargar). Cada
// cuota es su propio hecho de cobro: genera su propio CashMovement recién
// cuando se marca PAGADA — la Caja refleja plata que entró de verdad, no
// lo que se acordó cobrar a futuro.
enum CommissionInstallmentSource {
  VENTA
  ALQUILER
}

// A qué parte de la operación se le atribuye/imputa este cobro puntual
// — Comprador/Vendedor si la cuota es de una Venta, Inquilino/Propietario
// si es de un Alquiler. Nunca se mezclan los dos pares en una misma fila
// (los valida el propio código según source). Optativo: a veces no
// importa rastrear de qué parte vino puntualmente.
enum CommissionParty {
  COMPRADOR
  VENDEDOR
  INQUILINO
  PROPIETARIO
}

model CommissionInstallment {
  id Int @id @default(autoincrement())

  source CommissionInstallmentSource

  saleId Int?
  sale   Sale? @relation(fields: [saleId], references: [id], onDelete: Cascade)

  rentalCommissionId Int?
  rentalCommission   RentalCommission? @relation(fields: [rentalCommissionId], references: [id], onDelete: Cascade)

  numeroCuota Int
  totalCuotas Int
  amount      Decimal  @db.Decimal(14, 2)
  currency    String
  dueDate     DateTime

  status InstallmentStatus @default(PENDIENTE)
  paidAt DateTime?
  method PaymentMethod?

  attributedTo  CommissionParty?
  // Respaldo legal de esta cuota puntual — separado de attributedTo a
  // propósito: antes un solo campo mezclaba "quién firma el pagaré" con
  // "de quién es este cobro", y una cuota cobrada en efectivo sin pagaré
  // no tenía forma de decir de dónde vino.
  pagareFirmado Boolean          @default(false)
  notes         String?

  cashMovement CashMovement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([saleId])
  @@index([rentalCommissionId])
}

// Tasación: mismo criterio que Sale — hecho único, no pipeline. El
// reparto con un agente es opcional y fijo 50/50 (no versionado como
// Venta/Alquiler): se decide al cargar la tasación, no cambia después.
model Appraisal {
  id Int @id @default(autoincrement())

  unitId Int
  unit   Unit @relation(fields: [unitId], references: [id])

  amount      Decimal  @db.Decimal(14, 2)
  currency    String
  completedAt DateTime @default(now())

  // Renombrado de "agentId" a "vendedorAgentId" para que preguntar "de
  // qué agente es esto" sea el mismo campo en Sale/RentalCommission/
  // Appraisal — acá sigue siendo un solo rol con reparto fijo 50/50, no
  // pasa a tener captador.
  vendedorAgentId String?  @db.Uuid
  vendedorAgent   Profile? @relation("AppraisalVendedor", fields: [vendedorAgentId], references: [id])

  // Ambos null si no hay reparto (100% inmobiliaria).
  agentSharePercent Decimal? @db.Decimal(5, 2)
  agentAmount       Decimal? @db.Decimal(14, 2)

  notes String? @db.Text

  createdById String  @db.Uuid
  createdBy   Profile @relation("AppraisalCreadoPor", fields: [createdById], references: [id])

  // El informe de tasación enviado — un solo archivo por tasación, no un
  // listado tipado como ContractDocument (acá no hace falta distinguir
  // tipos). Subirlo de nuevo reemplaza la referencia, no crea historial.
  reportFileName     String?
  reportStoragePath  String?
  reportUploadedAt   DateTime?
  reportUploadedById String?   @db.Uuid
  reportUploadedBy   Profile?  @relation("AppraisalReportUploadedBy", fields: [reportUploadedById], references: [id])

  cashMovement CashMovement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
}

// Cuenta corriente de agentes: lo que se le debe a cada uno se calcula
// on-the-fly sumando vendedorAmount/captadorAmount/agenteFijoAmount ya
// congelados en RentalCommission/Sale (por rol) y agentAmount en
// Appraisal — no hay tabla de "deuda", esos montos YA SON la deuda,
// devengada desde que se cargó cada operación (independiente de si el
// cliente todavía está pagando en cuotas).
enum AgentDebtSource {
  RENTAL_COMMISSION
  SALE
  APPRAISAL
}

enum AgentDebtRole {
  VENDEDOR
  CAPTADOR
  AGENTE_FIJO
  TASACION
}

// Pago real registrado contra UNA línea puntual de lo devengado
// (identificada por sourceType+sourceId+role, ver getAgentDebtItems) —
// puede cubrir el total de esa línea o una parte; el saldo de esa línea
// es su monto menos la suma de estos pagos, y se puede seguir pagando
// el resto después. El saldo general del agente (por moneda) es la
// suma de lo devengado en todas sus líneas menos la suma de todos
// estos pagos, sin importar a qué línea se hayan imputado.
model AgentDebtPayment {
  id Int @id @default(autoincrement())

  agentId String  @db.Uuid
  agent   Profile @relation("AgentDebtPaymentAgente", fields: [agentId], references: [id])

  sourceType AgentDebtSource
  sourceId   Int
  role       AgentDebtRole

  amount   Decimal        @db.Decimal(14, 2)
  currency String
  paidAt   DateTime       @default(now())
  // Cómo salió la plata de la inmobiliaria hacia el agente — mismo
  // enum que ya se usa para los cobros (PaymentMethod), aunque acá el
  // sentido sea el de un egreso en vez de un ingreso.
  method   PaymentMethod?
  notes    String?        @db.Text

  createdById String  @db.Uuid
  createdBy   Profile @relation("AgentDebtPaymentCreadoPor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([sourceType, sourceId, role])
}

// FIJO: se repite mes a mes (alquiler de oficina, sueldos, servicios) —
// la proyección hacia adelante asume que sigue al mismo monto que la
// última carga real. VARIABLE: gasto puntual sin patrón (mantenimiento,
// marketing...) — a propósito NO se proyecta hacia adelante, como
// tampoco se proyectan Ventas/Tasaciones: no hay forma honesta de
// estimar algo sin patrón sin inventar un supuesto.
enum ExpenseType {
  FIJO
  VARIABLE
}

// Catálogo abierto de categorías de gasto — se crean sobre la marcha
// (Alquiler oficina, Sueldos, Luz...) sin tocar código. "Pagos a
// agentes" NO es una fila acá: ese gasto ya existe como dato
// (AgentDebtPayment) y se suma aparte en los reportes de caja, para no
// cargarlo dos veces.
model ExpenseCategory {
  id   Int         @id @default(autoincrement())
  name String      @unique
  type ExpenseType

  expenses Expense[]

  createdAt DateTime @default(now())
}

// Un gasto real cargado contra una categoría, mes a mes — el
// contrapeso de CashMovement (que solo registra ingresos) para que
// Caja pueda mostrar un neto real, no solo lo que entró en bruto.
model Expense {
  id Int @id @default(autoincrement())

  categoryId Int
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])

  amount     Decimal        @db.Decimal(14, 2)
  currency   String
  occurredAt DateTime       @default(now())
  method     PaymentMethod?
  notes      String?        @db.Text

  createdById String  @db.Uuid
  createdBy   Profile @relation("ExpenseCreadoPor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([occurredAt])
  @@index([categoryId])
}

// Fila única (id siempre 1) con los parámetros de la proyección
// financiera — hoy solo la banda de corrección por indexación de
// alquileres. Editable desde la propia pantalla de Proyección, sin
// tocar código: el supuesto de mercado (cuánto indexa en promedio)
// cambia con el tiempo.
model ProjectionSettings {
  id Int @id @default(1)

  // % mínimo y máximo que se suma al total proyectado de alquileres en
  // los meses que caen en o después de la próxima actualización
  // esperada de cada contrato (ver getProjection).
  indexationCorrectionMinPercent Decimal @default(7) @db.Decimal(5, 2)
  indexationCorrectionMaxPercent Decimal @default(10) @db.Decimal(5, 2)

  updatedAt DateTime @updatedAt
}

// Logos de marcas/servicios de terceros (Adinco, Argenprop...) para el
// carrusel de confianza del sitio público — administrado desde el
// backoffice, no viene del feed. El archivo vive en un bucket PÚBLICO
// de Supabase Storage (a diferencia de "contract-documents", que es
// privado): son imágenes de marketing, no hace falta URL firmada.
model PartnerLogo {
  id Int @id @default(autoincrement())

  name        String // solo para referencia en el admin (alt del logo)
  imageUrl    String // URL pública ya resuelta, lista para usar en <img>
  storagePath String // para poder borrar el archivo del bucket
  linkUrl     String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdById String  @db.Uuid
  createdBy   Profile @relation("PartnerLogoCreadoPor", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

enum BudgetType {
  ALQUILER
  VENTA
}

// A qué copia impresa pertenece un ítem — INQUILINO es la única que
// existe en un presupuesto de Alquiler; COMPRADOR/PROPIETARIO son las
// dos copias independientes de un presupuesto de Venta (ver comentario
// en Budget).
enum BudgetRecipient {
  INQUILINO
  COMPRADOR
  PROPIETARIO
}

// Presupuesto imprimible — se arma para negociar, antes (o en vez) de
// que exista un Contract/Sale real. A propósito sin FK a Unit/Client:
// `unitDetail` es texto libre (código Adinco, dirección, lo que sea) y
// los nombres de las partes también, porque no siempre hay una unidad
// cargada como Unit ni un Client registrado en este punto — ver
// resolveClientOptional para el mismo criterio aplicado a Contract/Sale
// una vez que la operación sí se concreta.
//
// Alquiler genera una sola copia (tenantName + items con recipient
// INQUILINO). Venta genera dos copias independientes con gastos propios
// cada una (buyerName + items COMPRADOR, ownerName + items PROPIETARIO)
// — no es el mismo ítem mostrado con otra cuenta, son conceptos
// distintos para cada parte.
model Budget {
  id   Int        @id @default(autoincrement())
  type BudgetType

  unitDetail String

  tenantName String? // solo type = ALQUILER
  buyerName  String? // solo type = VENTA
  ownerName  String? // solo type = VENTA

  currency String
  // Uso interno — nunca sale en el PDF (ver observations más abajo para
  // lo que sí tiene que verlo el cliente).
  notes    String? @db.Text

  // Texto libre que SÍ sale impreso en el presupuesto (ej. "precio
  // sujeto a confirmación", "incluye gastos de escritura", "válido por
  // 15 días") — a diferencia de `notes`, que es solo para uso interno.
  observations String? @db.Text

  items BudgetItem[]

  createdById String  @db.Uuid
  createdBy   Profile @relation("BudgetCreadoPor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([createdById])
}

model BudgetItem {
  id       Int    @id @default(autoincrement())
  budgetId Int
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  recipient   BudgetRecipient
  description String
  amount      Decimal @db.Decimal(14, 2)
  // Orden de carga — se preserva tal cual se tipeó, no se reordena
  // alfabéticamente ni por monto.
  sortOrder   Int

  @@index([budgetId])
}

// Catálogo administrable de conceptos frecuentes (ej. "Sellado de
// contrato", "Comisión inmobiliaria") — autocompleta concepto + precio
// sugerido al cargar un ítem, para no reescribir lo mismo en cada
// presupuesto. Simple CRUD editable en el momento, sin versionado: a
// diferencia de CommissionScheme, acá no hay ninguna operación ya
// cerrada que dependa de un valor congelado — BudgetItem siempre guarda
// su propio texto/monto, independiente de si el concepto del catálogo
// cambia o se borra después.
model BudgetConcept {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  defaultAmount Decimal? @db.Decimal(14, 2)

  createdById String  @db.Uuid
  createdBy   Profile @relation("BudgetConceptCreadoPor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
