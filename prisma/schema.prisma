// Prisma schema — sitio público + sincronización del feed Adinco.
// `Listing` es el caché del feed público: se sobreescribe en cada sync y
// no está pensado para cargar el peso del futuro sistema de gestión
// (contratos, inquilinos, pagos), que vivirá en tablas separadas y podrá
// referenciar un Listing sin acoplarse a su ciclo de vida.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Agency {
  id            Int      @id @default(autoincrement())
  externalId    String   @unique // real_estate_id
  name          String
  logoUrl       String?
  officeAddress String?
  officeZipCode String?
  phones        String[]

  listings  Listing[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Listing {
  id         Int     @id @default(autoincrement())
  externalId String  @unique // <id> del aviso en Adinco
  sourceUrl  String?

  title        String
  contentTitle String?
  description  String? @db.Text

  operationType String // "For Sale" | "For Rent"
  propertyType  String // Casa, Departamento, Campo, Terreno...

  priceAmount     Decimal? @db.Decimal(14, 2)
  priceCurrency   String?
  priceRaw        String? // ej. "Consultar precio"
  pricePerHectare Decimal? @db.Decimal(14, 2)
  expenses        Decimal? @db.Decimal(14, 2)

  address          String?
  addressName      String?
  addressNumber    String?
  addressFloor     String?
  addressApartment String?
  country          String?
  region           String?
  city             String?
  neighborhood     String?
  postcode         String?
  latitude         Decimal? @db.Decimal(11, 8)
  longitude        Decimal? @db.Decimal(11, 8)
  orientation      String?

  floorArea             Decimal? @db.Decimal(10, 2)
  plotArea              Decimal? @db.Decimal(10, 2)
  landArea              Decimal? @db.Decimal(10, 2)
  rooms                 Int?
  bathrooms             Int?
  condition             String?
  year                  Int?
  isNew                 Boolean?
  buildingFloors        Int?
  buildingMainElevators Int?
  buildingType          String?
  buildingCategory      String?
  coveredGarages        Int?
  aptoCredito           Boolean?

  fieldLength      Decimal? @db.Decimal(10, 2)
  fieldWidth       Decimal? @db.Decimal(10, 2)
  accessDetail     String?
  distancePavement Decimal? @db.Decimal(10, 2)
  countryType      String?

  services  String[]
  otherData String[]

  sellerName  String?
  sellerEmail String?

  sourceUpdatedAt DateTime? // <date> del aviso en el feed
  isActive        Boolean   @default(true) // false = desapareció del feed (delisted)
  rawData         Json // <ad> completo tal cual vino, sin perder campos

  agencyId Int?
  agency   Agency? @relation(fields: [agencyId], references: [id])

  images ListingImage[]
  videos ListingVideo[]

  // Fase 2 (backoffice): un Listing puede estar bajo gestión (Unit) y/o
  // haber resuelto pedidos de demanda, sin que Listing dependa de ellos.
  unit           Unit?
  matchedPedidos Pedido[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operationType])
  @@index([propertyType])
  @@index([city])
  @@index([isActive])
}

model ListingImage {
  id         Int     @id @default(autoincrement())
  listingId  Int
  listing    Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url        String
  isFeatured Boolean @default(false)
  sortOrder  Int     @default(0)

  @@index([listingId])
}

model ListingVideo {
  id        Int     @id @default(autoincrement())
  listingId Int
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String

  @@index([listingId])
}

// Fila única (id fijo = 1) que guarda el último Last-Modified/ETag HTTP
// visto, para saltear el reprocesamiento del feed si no cambió.
model SyncState {
  id           Int       @id @default(1)
  lastModified String?
  etag         String?
  lastSyncedAt DateTime?
}

// ============================================================
// Backoffice (fase 2): usuarios/roles, pedidos y alquileres.
// Todo lo de acá abajo vive separado del caché del feed público
// de arriba — solo se referencia opcionalmente vía Unit <-> Listing.
// ============================================================

enum StaffRole {
  ADMIN
  AGENTE
}

// Espeja auth.users de Supabase (mismo id). La fila se crea sola por un
// trigger de Postgres (handle_new_user) cuando un admin da de alta el
// login en el dashboard de Supabase.
model Profile {
  id          String    @id @db.Uuid
  email       String    @unique
  username    String    @unique
  firstName   String?
  lastName    String?
  role        StaffRole @default(AGENTE)
  // Claves del catálogo en src/lib/permissions.ts. El rol carga un set
  // por defecto al crear el usuario, pero lo que se chequea en cada
  // accion es esto, no el rol.
  permissions String[]  @default([])
  isActive    Boolean   @default(true)

  pedidosCreados    Pedido[]           @relation("PedidoCreadoPor")
  contratosCreados  Contract[]         @relation("ContractCreadoPor")
  documentosSubidos ContractDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PedidoEstado {
  ABIERTO
  EN_BUSQUEDA
  CONSEGUIDO
  DESCARTADO
}

// Tablero de demanda: un cliente pide algo que hoy no está en stock: el
// agente lo carga acá para que cualquiera de la agencia pueda ofrecer un
// match desde su propia red, no solo desde los Listing existentes.
model Pedido {
  id Int @id @default(autoincrement())

  clienteNombre   String
  clienteTelefono String?
  clienteEmail    String?

  operationType String // "Venta" | "Alquiler"
  propertyType  String?
  zona          String?
  precioMin     Decimal? @db.Decimal(14, 2)
  precioMax     Decimal? @db.Decimal(14, 2)
  moneda        String?
  ambientesMin  Int?
  notas         String?  @db.Text

  estado PedidoEstado @default(ABIERTO)

  creadoPorId String  @db.Uuid
  creadoPor   Profile @relation("PedidoCreadoPor", fields: [creadoPorId], references: [id])

  matchedListingId Int?
  matchedListing   Listing? @relation(fields: [matchedListingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estado])
}

// La propiedad real bajo gestión. Puede o no estar publicada (Listing);
// existe independiente de él para no perder historial de contratos si el
// aviso se cae del feed.
model Unit {
  id           Int     @id @default(autoincrement())
  // Código interno de referencia (convención Adinco) — la inmobiliaria
  // referencia todas sus propiedades así, esté o no publicada. Único:
  // es la clave real para buscar/reutilizar una unidad entre contratos.
  propertyCode String  @unique
  address      String
  city         String?
  region       String?
  propertyType String?
  notes        String? @db.Text

  listingId Int?     @unique
  listing   Listing? @relation(fields: [listingId], references: [id])

  contracts Contract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Padrón único de personas (propietarios, inquilinos, garantes). Es
// pura identidad/contacto — a propósito NO guarda nada financiero
// (mora, deuda): eso siempre se calcula desde Contract/Payment,
// filtrado por el rol que cumplió en cada contrato puntual, para que
// una persona no "herede" mora de un rol que no cumplió.
model Client {
  id        Int       @id @default(autoincrement())
  firstName String
  lastName  String
  docId     String?
  birthDate DateTime?
  email     String?
  phone     String?

  contractsAsTenant Contract[]          @relation("ContractTenant")
  contractsAsOwner  Contract[]          @relation("ContractOwner")
  guarantorFor      ContractGuarantor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([docId])
  @@index([lastName, firstName])
}

// Uno o más por contrato. A diferencia de Owner/Tenant en la v1
// anterior, un mismo Client puede ser garante de varios contratos a lo
// largo del tiempo — por eso es tabla puente, no una fila propia de
// cada contrato.
model ContractGuarantor {
  id Int @id @default(autoincrement())

  contractId Int
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  clientId Int
  client   Client @relation(fields: [clientId], references: [id])

  createdAt DateTime @default(now())

  @@unique([contractId, clientId])
}

// Catálogo de índices de actualización (ICL, CAC, IPC...). El admin
// puede cargar nuevos desde el propio formulario de contrato.
model IndexType {
  id   Int     @id @default(autoincrement())
  code String  @unique
  name String?

  contracts   Contract[]
  indexations Indexation[]

  createdAt DateTime @default(now())
}

// Catálogo de conceptos de liquidación (Alquiler, Expensas, Agua, Luz,
// CSP, Mora...). "Alquiler" es isSystem: siempre existe, no se borra.
model Concept {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isSystem Boolean @default(false)

  contractConcepts ContractConcept[]
  paymentItems     PaymentItem[]

  createdAt DateTime @default(now())
}

// Qué conceptos recurrentes tiene un contrato — sin monto: el monto se
// carga liquidación por liquidación porque varía mes a mes (expensas,
// agua...). "Alquiler" no pasa por acá, es implícito en cada Payment.
model ContractConcept {
  id Int @id @default(autoincrement())

  contractId Int
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  conceptId Int
  concept   Concept @relation(fields: [conceptId], references: [id])

  @@unique([contractId, conceptId])
}

enum ContractStatus {
  ACTIVO
  FINALIZADO
  RESCINDIDO
}

model Contract {
  id Int @id @default(autoincrement())

  unitId Int
  unit   Unit @relation(fields: [unitId], references: [id])

  ownerId Int
  owner   Client @relation("ContractOwner", fields: [ownerId], references: [id])

  tenantId Int
  tenant   Client @relation("ContractTenant", fields: [tenantId], references: [id])

  // Transferencias — se cargan por contrato (no por cliente): cada
  // contrato puede tener una cuenta de cobro distinta, y el agente que
  // liquida necesita tenerla a mano en ese contrato puntual.
  paymentAlias String?
  paymentCBU   String?

  // Renovación = contrato nuevo enlazado al anterior, nunca se estira
  // la fecha de fin de uno existente (ya tiene su propio cronograma de
  // liquidaciones/indexaciones generado).
  renewedFromContractId Int?
  renewedFrom           Contract?  @relation("ContractRenewal", fields: [renewedFromContractId], references: [id])
  renewals              Contract[] @relation("ContractRenewal")

  terminatedAt      DateTime?
  terminationReason String?   @db.Text

  startDate      DateTime
  durationMonths Int
  // Calculada (startDate + durationMonths) al crear/editar el contrato;
  // se guarda igual para poder filtrar/ordenar por ella.
  endDate        DateTime

  rentAmount Decimal        @db.Decimal(14, 2)
  currency   String
  status     ContractStatus @default(ACTIVO)

  // % que se descuenta del alquiler en cada liquidación como comisión
  // de administración inmobiliaria (nunca sobre expensas/agua/etc).
  managementFeePercent Decimal @db.Decimal(5, 2)

  indexationFrequencyMonths Int?
  indexTypeId               Int?
  indexType                 IndexType? @relation(fields: [indexTypeId], references: [id])
  lastIndexedAt             DateTime?
  nextIndexationDueAt       DateTime?

  notes String? @db.Text

  createdById String  @db.Uuid
  createdBy   Profile @relation("ContractCreadoPor", fields: [createdById], references: [id])

  guarantors  ContractGuarantor[]
  concepts    ContractConcept[]
  payments    Payment[]
  indexations Indexation[]
  documents   ContractDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([unitId])
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  ATRASADO
}

// Un registro por período: es la liquidación mensual. El monto total no
// se guarda acá — se suma a partir de sus PaymentItem, para no tener un
// total que se pueda desincronizar de las líneas reales.
model Payment {
  id Int @id @default(autoincrement())

  contractId Int
  contract   Contract @relation(fields: [contractId], references: [id])

  periodMonth Int
  periodYear  Int
  dueDate     DateTime

  currency   String
  status     PaymentStatus @default(PENDIENTE)
  paidAt     DateTime?
  paidAmount Decimal?      @db.Decimal(14, 2) // snapshot de la suma al momento de pagar
  notes      String?

  items PaymentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractId, periodYear, periodMonth])
  @@index([status])
}

// Una línea de la liquidación (Alquiler, Expensas, Agua...). El monto
// nace en blanco salvo el de Alquiler — se completa liquidación por
// liquidación porque varía mes a mes.
model PaymentItem {
  id Int @id @default(autoincrement())

  paymentId Int
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  conceptId Int
  concept   Concept @relation(fields: [conceptId], references: [id])

  amount Decimal? @db.Decimal(14, 2)
  notes  String?

  @@index([paymentId])
}

// Historial de actualizaciones de precio del contrato.
model Indexation {
  id Int @id @default(autoincrement())

  contractId Int
  contract   Contract @relation(fields: [contractId], references: [id])

  appliedAt      DateTime @default(now())
  previousAmount Decimal  @db.Decimal(14, 2)
  newAmount      Decimal  @db.Decimal(14, 2)

  indexTypeId Int?
  indexType   IndexType? @relation(fields: [indexTypeId], references: [id])
  notes       String?

  createdAt DateTime @default(now())
}

enum DocumentType {
  CONTRATO
  DNI_INQUILINO
  DNI_GARANTE
  OTRO
}

// Archivos en Supabase Storage (bucket privado "contract-documents");
// acá solo se guarda la referencia. Se suben después de crear el
// contrato, no forman parte de esa transacción.
model ContractDocument {
  id Int @id @default(autoincrement())

  contractId Int
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  type        DocumentType
  fileName    String
  storagePath String

  uploadedById String  @db.Uuid
  uploadedBy   Profile @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}
