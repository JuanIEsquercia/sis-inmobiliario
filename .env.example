# Connection strings de Supabase (botón "Connect" del dashboard > ORMs > Prisma).
# DATABASE_URL: pooler de transacciones (puerto 6543) — la usa la app en runtime.
# DIRECT_URL: conexión directa (puerto 5432) — la usa Prisma para migraciones.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[host].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[host].pooler.supabase.com:5432/postgres"

# Feed público de Adinco para Garcia Propiedades.
ADINCO_FEED_URL="https://feeds.adinco.net/20372/7a5210e15b118/ar_adinco.xml"

# Token para autorizar POST /api/sync (header x-sync-secret). Generar uno
# random, ej: openssl rand -hex 32
SYNC_SECRET="change-me"

# Dashboard de Supabase > Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Misma pantalla, la key con privilegios de admin (puede figurar como
# "service_role key" o "secret key" según la versión del dashboard).
# Server-only: nunca con prefijo NEXT_PUBLIC_. La usa la Admin API para
# crear logins de staff desde /backoffice/usuarios/nuevo.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
